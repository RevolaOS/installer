{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RevolaOS Installer",
  "identifier": "org.revolaos.installer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RevolaOS Installer",
        "width": 1600,
        "height": 900,
        "minWidth": 800,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Install RevolaOS on your iPod Classic",
    "longDescription": "Validate Apple firmware, back up boot firmware, and install RevolaOS on supported iPod Classic devices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-revolaos.rules": "linux/70-revolaos.rules"
        },
        "postInstallScript": "linux/reload-udev.sh",
        "postRemoveScript": "linux/reload-udev.sh"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "files": {
          "/usr/lib/udev/rules.d/70-revolaos.rules": "linux/70-revolaos.rules"
        },
        "postInstallScript": "linux/reload-udev.sh",
        "postRemoveScript": "linux/reload-udev.sh"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0OUE0MzdBQjVCRTI1QjcKUldTM0piNjFla09hOUNWOVo1ZW1iclNDc0llM2RHRU4zZ0pSYUZGc3BqeHVXYzBvS2pNZWpVdVQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
